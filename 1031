#include <stdio.h>

int josephus(int n, int m) {
    int position = 0;
    for (int i = 2; i <= n; i++) {
        position = (position + m) % i;
    }
    return position;
}

int main() {
    int n;
    
    while (scanf("%d", &n) == 1 && n != 0) {
        int m = 1;
        while (1) {
            if (josephus(n - 1, m) == 11) {
                printf("%d\n", m);
                break;
            }
            m++;
        }
    }
    
    return 0;
}
